## producer.py --help
usage: producer.py [-h] --mode {file,kafka} [--n N] [--seed SEED]
                   [--restaurants RESTAURANTS] [--late-ratio LATE_RATIO]
                   [--max-late-minutes MAX_LATE_MINUTES]
                   [--dup-ratio DUP_RATIO] [--cancel-ratio CANCEL_RATIO]
                   [--output OUTPUT] [--start START] [--days DAYS]
                   [--bootstrap BOOTSTRAP] [--topic TOPIC] [--rate RATE]
                   [--duration DURATION] [--time-scale TIME_SCALE]
                   [--start-id START_ID]

RECONSTITUTION du générateur de commandes (fichier du professeur non fourni).

options:
  -h, --help            show this help message and exit
  --mode {file,kafka}   file = historique JSON Lines ; kafka = flux continu
                        vers le topic (default: None)
  --n N                 nombre de COMMANDES (file : défaut 50000 ; kafka :
                        illimité) (default: None)
  --seed SEED           graine aléatoire (reproductibilité) (default: 42)
  --restaurants RESTAURANTS
                        référentiel des restaurants (JSON Lines ou tableau
                        JSON) (default: /workspace/data/restaurants.json)
  --late-ratio LATE_RATIO
                        proportion d'événements émis en retard (default: 0.05)
  --max-late-minutes MAX_LATE_MINUTES
                        retard maximal d'un événement (minutes, retard minimal
                        = 1) (default: 15.0)
  --dup-ratio DUP_RATIO
                        proportion d'événements ré-émis en doublon (default:
                        0.02)
  --cancel-ratio CANCEL_RATIO
                        proportion de commandes annulées (default: 0.08)

mode file:
  --output OUTPUT       fichier de sortie (un fichier .stats.json est écrit à
                        côté) (default:
                        /workspace/data/generated/orders_history.jsonl)
  --start START         début de la période simulée (UTC) (default:
                        2026-10-01T00:00:00Z)
  --days DAYS           durée de la période simulée (jours) (default: 30)

mode kafka:
  --bootstrap BOOTSTRAP
                        serveurs Kafka (env KAFKA_BOOTSTRAP) (default:
                        kafka:9092)
  --topic TOPIC         topic cible (default: orders)
  --rate RATE           débit cible en événements par seconde (default: 20)
  --duration DURATION   durée en secondes (0 = jusqu'à Ctrl+C) (default: 0)
  --time-scale TIME_SCALE
                        accélération du cycle de vie (10 = livraisons 10x plus
                        rapides) ; les retards réseau et doublons restent en
                        temps réel (default: 1.0)
  --start-id START_ID   premier numéro de commande (défaut : reprise du
                        fichier d'état, sinon 1000000) (default: None)

